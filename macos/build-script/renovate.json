      "customType": "regex",
      "managerFilePatterns": [
        "version/aom"
      ],
      "matchStrings": [
        "^(?<currentValue>[0-9.]+)$"
      ],
      "datasourceTemplate": "git-tags",
      "depNameTemplate": "aom",
      "packageNameTemplate": "https://aomedia.googlesource.com/aom",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v(?<version>[0-9.]+)$"
    },
